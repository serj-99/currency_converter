{
  "manifest_version": 3,
  "name": "Конвертер валют",
  "version": "1.2.0",
  "description": "Конвертация выбранных валют по курсу Банка России.",
  "action": {
    "default_title": "Конвертер валют",
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  },
  "icons": {
    "48": "icon.svg"
  },
  "host_permissions": [
    "https://www.cbr.ru/*"
  ],
  "permissions": ["storage"],
  "browser_specific_settings": {
    "gecko": {
      "id": "currency-converter-cbr@example.com",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
